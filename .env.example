# Copy this file to .env and fill it in. Never commit .env.

# From Google Cloud Console → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Run "npm run keygen" and paste the two lines it prints here
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# "local" = just you, signed in automatically. "hosted" = real login (Phase 6).
APP_MODE=local
PORT=3000
# Must match the redirect URI in Google Cloud (BASE_URL + /auth/callback)
BASE_URL=http://localhost:3000
DATABASE_PATH=data/app.db
# Largest video the app will accept, in megabytes (default 20 GB)
MAX_UPLOAD_MB=20480
